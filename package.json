  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --write \"{app,components,services,theme,types,utils,__tests__}/**/*.{ts,tsx}\" \"*.{ts,js,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{app,components,services,theme,types,utils,__tests__}/**/*.{ts,tsx}\" \"*.{ts,js,json,md}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2"
  }
